{
  "name": "production-agent-workshop",
  "version": "0.1.40",
  "private": true,
  "type": "module",
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": ">=24.15.0",
    "npm": ">=12"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "backup:data": "tsx scripts/data-snapshot.ts backup",
    "restore:data": "tsx scripts/data-snapshot.ts restore",
    "report:run": "tsx scripts/run-report.ts",
    "drill:incidents": "tsx scripts/incident-drills.ts",
    "preflight:release": "tsx scripts/release-preflight.ts",
    "demo": "tsx src/demo.ts",
    "eval": "tsx src/evals.ts",
    "build": "tsc",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "check": "tsc --noEmit",
    "prepare": "husky",
    "precommit": "lint-staged",
    "test": "tsx --test tests/*.test.ts",
    "test:coverage": "tsx --test --experimental-test-coverage --test-coverage-include=src/**/*.ts --test-coverage-lines=95 --test-coverage-branches=85 --test-coverage-functions=95 tests/*.test.ts",
    "verify": "npm run format:check && npm run lint && npm run check && npm test && npm run eval"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.84.1",
    "typebox": "1.3.10"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@types/node": "^24.13.3",
    "husky": "9.1.7",
    "lint-staged": "17.3.0",
    "tsx": "^4.23.5",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "minimatch": "10.2.6",
    "undici": "8.10.0"
  },
  "allowScripts": {
    "@google/genai@1.52.0": true,
    "protobufjs@7.6.5": true,
    "esbuild@0.28.1": true
  },
  "lint-staged": {
    "*.{ts,json}": "biome check --write --no-errors-on-unmatched"
  }
}
