{
  "name": "production-agent-workshop",
  "version": "0.1.13",
  "private": true,
  "type": "module",
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": ">=24.15.0",
    "npm": ">=12"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "demo": "tsx src/demo.ts",
    "eval": "tsx src/evals.ts",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "verify": "npm run format:check && npm run check && npm test && npm run eval"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.83.0",
    "typebox": "1.3.10"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@types/node": "^24.13.3",
    "tsx": "^4.23.5",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "minimatch": "10.2.6",
    "undici": "8.10.0"
  },
  "allowScripts": {
    "@google/genai@1.52.0": true,
    "protobufjs@7.6.5": true,
    "esbuild@0.28.1": true
  }
}
