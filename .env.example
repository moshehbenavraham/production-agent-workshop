PORT=3000
EVENT_LOG_PATH=./data/events.jsonl
APPROVAL_LOG_PATH=./data/approvals.jsonl
RUN_RATE_LIMIT_MAX=10
RUN_RATE_LIMIT_WINDOW_MS=60000

# Pi can use provider credentials already configured in ~/.pi/agent/auth.json.
# Alternatively, expose one supported provider key to the process:
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
