# ====================================================================================
# `.env.example` environment variables template, copy to `.env` and fill in the values
# ====================================================================================

# ===========================================
# Port and Event Log
# ===========================================
PORT=3000
EVENT_LOG_PATH=./data/events.jsonl
APPROVAL_LOG_PATH=./data/approvals.jsonl
PRODUCTION_EVAL_LOG_PATH=./data/production-evals.jsonl

# ===========================================
# Run Configuration
# ===========================================
RUN_DEADLINE_MS=30000
RUN_MAX_STEPS=24
RUN_RATE_LIMIT_MAX=10
RUN_RATE_LIMIT_WINDOW_MS=60000

# ===========================================
# LLM Provider Keys
# ===========================================
# Leave an unused provider blank. At least one supported provider credential
# must be injected through Coolify's secret store for a provider-backed smoke run.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ===========================================
# Coolify Control Plane
# ===========================================
# Keep real tokens, credentials, private URLs, and Coolify identifiers only in
# the ignored local `.env` and the Coolify secret store.
COOLIFY_API_TOKEN=<coolify-api-token-with-read-write-deploy>
COOLIFY_API_URL=https://coolify.example.com/api/v1

# ===========================================
# Coolify Source And Application
# ===========================================
GITHUB_REPO=owner/repository
GITHUB_BRANCH=main
APP_NAME=production-agent-workshop
APP_DOMAIN=agent.example.com
COOLIFY_RELEASE_REVISION=<40-character-git-sha>
COOLIFY_IMAGE_DIGEST=<sha256-image-digest>
COOLIFY_SERVER_UUID=<coolify-server-uuid>
COOLIFY_PROJECT_UUID=<coolify-project-uuid>
COOLIFY_ENVIRONMENT_UUID=<coolify-environment-uuid>
COOLIFY_ENVIRONMENT_NAME=controlled
COOLIFY_APPLICATION_UUID=<coolify-application-uuid>
COOLIFY_DEPLOYMENT_UUID=<coolify-deployment-uuid>

# ===========================================
# Coolify Controlled Access And Persistence
# ===========================================
COOLIFY_APP_URL=https://agent.example.com
COOLIFY_HEALTH_URL=https://agent.example.com/health
COOLIFY_BASIC_AUTH_USERNAME=<controlled-operator-username>
COOLIFY_BASIC_AUTH_PASSWORD=<generated-basic-auth-password>
COOLIFY_EVENT_LOG_PATH=/app/data/events.jsonl
COOLIFY_APPROVAL_LOG_PATH=/app/data/approvals.jsonl
COOLIFY_PRODUCTION_EVAL_LOG_PATH=/app/data/production-evals.jsonl
COOLIFY_PERSISTENT_MOUNT_PATH=/app/data
COOLIFY_HEALTHCHECK_MODE=dockerfile

# ===========================================
# Workshop Operator And Local Backup
# ===========================================
# The workshop owner performs deploy, pause, recovery, credential rotation,
# backup, restore, incident, and rollback procedures.
COOLIFY_SMOKE_RUN_ID=<synthetic-smoke-run-uuid>
COOLIFY_OPERATOR_ROLE=workshop_owner
COOLIFY_BACKUP_DESTINATION_KIND=operator_local_workstation
COOLIFY_BACKUP_LOCAL_PATH=/absolute/operator-owned-backup-path
COOLIFY_BACKUP_RETENTION_DAYS=30
COOLIFY_BACKUP_SCHEDULE=manual_before_and_after_workshop_demo
COOLIFY_BACKUP_LATEST_SNAPSHOT=<snapshot-directory-name>
COOLIFY_BACKUP_RESTORE_DRILL=<pending-or-verified>
COOLIFY_ROLLBACK_IMAGE_DIGEST=<sha256-image-digest>
COOLIFY_ROLLBACK_REVISION=<40-character-git-sha>
COOLIFY_ROLLBACK_RESERVED=<true-or-false>
